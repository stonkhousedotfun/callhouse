# ---------------------------------------------------------------------------------------------
# @callhouse/web — every variable this app reads.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, not read at runtime. Changing one means
# rebuilding the app. Everything without the prefix is server-side only and is read per request.
#
# Only NEXT_PUBLIC_VAULT has no compiled-in default: the vault does not exist until it is
# deployed. Every other address below was confirmed on chain 4663 by eth_getCode during recon and
# is compiled into lib/contracts.ts, so these lines are overrides for a fork or a rehearsal
# deploy — not blanks to be filled in.
# ---------------------------------------------------------------------------------------------

# ---- required ----
# The deployed Callhouse vault. Without it the pages render a "not configured" notice.
NEXT_PUBLIC_VAULT=

# ---- domains ----
# The frontend is split across two domains and two repositories:
#   callhouse.xyz      -> leekzor/callhouse-site  the static marketing landing. No wallet code at all.
#   app.callhouse.xyz  -> web/                    THIS package, the dapp. Every route unchanged.
# This app is served from app.callhouse.xyz. Both values below are NEXT_PUBLIC_*, so both are
# inlined at BUILD time, and both have the production domain compiled in as a default in
# lib/site.ts — these lines are overrides for a preview deploy or local work, not blanks.
# Used for two things only: the link back to the marketing site, and the absolute base for page
# metadata (canonical + Open Graph). Neither is ever used to reach the chain.
NEXT_PUBLIC_SITE_URL=https://callhouse.xyz
NEXT_PUBLIC_APP_URL=https://app.callhouse.xyz
# The Terms of Use and privacy notice are pages on the marketing site (${NEXT_PUBLIC_SITE_URL}/terms
# and /privacy) and this app only links to them. The operator facts they render — entity name,
# jurisdiction, governing law, the legal / privacy / security contacts — are NEXT_PUBLIC_OPERATOR_*
# and friends in the .env.example of leekzor/callhouse-site, read by its lib/legal.ts. Nothing in
# this package reads them and there is nothing to set here; see ops/launch-legal.md.

# ---- chain ----
NEXT_PUBLIC_CHAIN_ID=4663
# Primary first. This one serves archive reads and full-range eth_getLogs; the backup does not
# (it answers "Archive requests require a personal token"), so the /activity log fallback uses
# the primary only.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RPC_URL_2=https://robinhood-rpc.publicnode.com
# Links only. Blockscout's API sits behind a Cloudflare challenge, so nothing here fetches it.
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# ---- indexer ----
# Ponder + Hono read API (plan section 6). Optional: if it is unreachable, /activity rebuilds the
# weekly history from the vault's own logs and every other page is unaffected.
NEXT_PUBLIC_API_URL=http://localhost:42069

# ---- optional overrides, all with explorer-confirmed defaults ----
# NVDA Stock Token, 18 decimals
NEXT_PUBLIC_ASSET=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
# USDG, 6 decimals
NEXT_PUBLIC_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# OvercallRegistry for the NVDA market. NOT the top-level `registry` key in Overcall's own
# frontend config — that one is the JUGGERNAUT market.
NEXT_PUBLIC_REGISTRY=0x8E973cE1A6884E28Ad3E377d5f670Bc0b463f4EA
NEXT_PUBLIC_CLEARINGHOUSE=0x9a7b40e5c1dB1Af822ef091c990b58b02C78C0C0
NEXT_PUBLIC_SEAPORT=0x0000000000000068F116a894984e2DB1123eB395

# Vault deploy block. Makes the /activity log fallback one cheap query instead of a full scan.
NEXT_PUBLIC_VAULT_FROM_BLOCK=0

# ---- server side only ----
# Base URL for the read-only Overcall order-book proxy in app/api/overcall/listings.
# Their API sends no CORS headers, so the browser cannot call it directly.
OVERCALL_API_BASE=https://overcall.finance
