{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "indexer/Dockerfile",
    "watchPatterns": [
      "indexer/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "keeper/package.json",
      "web/package.json",
      "relay/package.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 10800,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
