# ---------------------------------------------------------------------------
# Stonkhouse indexer — copy to .env.local (ponder loads that file automatically)
# ---------------------------------------------------------------------------

# ---- required ----

# Archive RPC for chain 4663. Backfill runs eth_call at historical blocks as well as
# historical eth_getLogs. rpc.mainnet.chain.robinhood.com answers "metadata is not found"
# on a historical eth_call, and the publicnode backup answers "Archive requests require a
# personal token", so neither can backfill. Production uses a keyed Alchemy endpoint.
# The URL carries the API key: keep it out of commits and logs.
PONDER_RPC_URL_4663=https://robinhood-mainnet.g.alchemy.com/v2/<your-key>

# The deployed Stonkhouse vault. Alias: VAULT.
VAULT_ADDRESS=

# Block the vault was deployed in. Required: chain 4663 is past block
# 61,000,000 and a genesis scan is not a viable backfill.
START_BLOCK=

# Postgres. Omit for a local PGlite database under .ponder/pglite.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/callhouse
# Railway/Heroku-style private network URL. Ponder prefers it over DATABASE_URL when both
# are set; use it for a same-project Postgres so traffic never leaves the private network.
DATABASE_PRIVATE_URL=

# Database schema (namespace). Ponder requires one explicitly; pass --schema
# on the CLI or set it here.
DATABASE_SCHEMA=callhouse

# ---- optional ----

# Last block to index, inclusive. Leave unset in production (follow the head).
# Set it to bound a replay for a fork dry-run or a smoke test.
END_BLOCK=

# ---- protocol addresses (defaults are the eth_getCode-confirmed mainnet ones) ----
# Override only for a fork or a dry-run deployment. There is no registry and no Overcall:
# the vault numbers its own cycles and its own Seaport listing is the only venue.
# CLEARINGHOUSE must be the one the vault was constructed with (Vault.clear()); a deployment on
# our own DeployClear.s.sol instance sets it here and in ops/addresses.json.
CLEARINGHOUSE=0x9a7b40e5c1dB1Af822ef091c990b58b02C78C0C0
SEAPORT=0x0000000000000068F116a894984e2DB1123eB395
USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
ASSET=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
# Multicall3, canonical address, eth_getCode-confirmed on 4663. The read API batches its
# ~30 live views through aggregate3; one at a time they blow any sane deadline on a public RPC.
MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11

# Deadline on ONE batched live read, milliseconds. Default 8000. A batch is a single eth_call;
# past this the API answers from the index with live:false instead of hanging.
LIVE_READ_TIMEOUT_MS=

# ---- server ----
PORT=42069
