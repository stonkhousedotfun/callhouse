# ---------------------------------------------------------------------------
# Stonkhouse indexer — copy to .env.local (ponder loads that file automatically)
# ---------------------------------------------------------------------------

# ---- required ----

# RPC for chain 4663. The VAULT's backfill runs eth_call at historical blocks as well as
# historical eth_getLogs, so it needs an archive endpoint: rpc.mainnet.chain.robinhood.com
# answers "historical state ... is not available" on a historical eth_call, and the publicnode
# backup answers "Archive requests require a personal token". Production uses a keyed Alchemy
# endpoint. A FACTORY market's handlers are log-only and backfill on the public RPC; only the
# optional Factory:setup read of policy()/feeRecipient()/depositCap() at START_BLOCK needs the
# archive, and without it those three stay unverified on /v1/market (README "Factory markets").
# The URL carries the API key: keep it out of commits and logs.
PONDER_RPC_URL_4663=https://robinhood-mainnet.g.alchemy.com/v2/<your-key>

# ---- legacy products: optional when the v2 group below is configured ----
# The pooled Stonkhouse vault. Alias: VAULT. The NVDA deployment sets this and only this.
VAULT_ADDRESS=
# A factory market (contracts/src/solo/): the AccountFactory. Alias: FACTORY. One process per
# market; set it to ops/markets/tier1.json -> markets[].deployment.factory. Its WriterAccount clones
# are discovered from AccountCreated, so nothing else about the market is configured here.
FACTORY_ADDRESS=
# The ticker the factory market is published under (/v1/market.ticker, /v1/health.market).
# A label only; OPTIONAL, defaults to NVDA — set it on every non-NVDA market, or that market's
# payloads say NVDA (lib/env.ts warns at boot when FACTORY_ADDRESS is set without it).
MARKET=NVDA

# Block the legacy product was deployed in. Required when VAULT_ADDRESS or FACTORY_ADDRESS is set:
# chain 4663 is past block
# 61,000,000 and a genesis scan is not a viable backfill. For a factory market it is that
# market's deployment.deployBlock in ops/markets/tier1.json (NVDA: 64038234).
START_BLOCK=

# ---- v2: one Clearinghouse indexes all v2 markets ----
# Set all five addresses and V2_START_BLOCK together. Leave all unset for a v1-only process.
# V2_CLEARINGHOUSE is distinct from the legacy Valorem CLEARINGHOUSE above.
V2_CLEARINGHOUSE=
V2_ORDER_BOOK=
V2_SETTLEMENT_ORACLE=
V2_AUTO_ROLLER=
V2_MAKER_REGISTRY=
# Optional v2 periphery event sources. Leave unset for an existing five-address deployment.
V2_EXPIRY_CALENDAR=
V2_KEEPER_REWARDS=
V2_MAKER_VAULT=
# JSON array of {"program":"<open string>","address":"0x..."}. Keep replaced instances listed
# while they still have claims. The singular maker variable below remains a legacy fallback.
V2_REWARDS_DISTRIBUTORS=
V2_REWARDS_DISTRIBUTOR=
# Optional v8 authority and payout sources; indexed from V2_START_BLOCK.
V2_ACCESS_MANAGER=
V2_PAYOUT_ROUTER=
# Optional v8 flywheel sources. The executor requires the splitter.
V2_FEE_SPLITTER=
V2_BUYBACK_EXECUTOR=
# STONKHOUSE token whose event-block totalSupply is stored with each canonical Burned row.
V2_FLYWHEEL_TOKEN_ADDRESS=
# Required with V2_FEE_SPLITTER; the splitter can predate the core deployment.
V2_FLYWHEEL_START_BLOCK=
# Optional P8 lending periphery. V2_EARN_VAULT is the LENDING vault (shares against a supplied
# Stock Token or USDG), NOT the /earn covered-call writing surface of the web app.
V2_EARN_VAULT=
V2_ZAP_HELPER=
# Required with either address above; both are deployed after the core, so V2_START_BLOCK is both
# a wasted backfill and, if guessed late, a silent loss of the vault's first deposits.
V2_EARN_START_BLOCK=
# Optional P8-06 House vault factory. Clones are discovered from VaultCreated; do not
# point V2_MAKER_VAULT at a House vault (depositor withdrawals would be treasury exits).
V2_HOUSE_VAULT_FACTORY=
# Required with V2_HOUSE_VAULT_FACTORY; the factory is deployed after the core.
V2_HOUSE_START_BLOCK=
# Required with V2_CLEARINGHOUSE; use the v2 deployment block, not a genesis scan.
V2_START_BLOCK=
# Optional HTTP(S) pricing service for v2 quotes and cards.
PRICING_URL=

# Postgres. Omit for a local PGlite database under .ponder/pglite.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/callhouse
# Railway/Heroku-style private network URL. Ponder prefers it over DATABASE_URL when both
# are set; use it for a same-project Postgres so traffic never leaves the private network.
DATABASE_PRIVATE_URL=

# Database schema (namespace). Ponder requires one explicitly; pass --schema
# on the CLI or set it here.
DATABASE_SCHEMA=callhouse
# Stable live-view namespace. A v8 service using callhouse_v2 must not share its Postgres database
# with the v7 run-off service, which uses the same fixed name.
DATABASE_VIEWS_SCHEMA=callhouse_v2

# ---- optional ----

# Last block to index, inclusive. Leave unset in production (follow the head).
# Set it to bound a replay for a fork dry-run or a smoke test.
END_BLOCK=

# ---- protocol addresses (defaults are the eth_getCode-confirmed mainnet ones) ----
# Override only for a fork or a dry-run deployment. There is no registry and no Overcall:
# the vault numbers its own cycles and its own Seaport listing is the only venue.
# These are VAULT-ONLY: a factory market ignores ASSET/CLEARINGHOUSE — its own asset and Clear
# are read from the factory at setup and published from there, never from these defaults.
# CLEARINGHOUSE must be the one the vault was constructed with (Vault.clear()); a deployment on
# our own DeployClear.s.sol instance sets it here and in ops/addresses.json.
CLEARINGHOUSE=0x9a7b40e5c1dB1Af822ef091c990b58b02C78C0C0
SEAPORT=0x0000000000000068F116a894984e2DB1123eB395
USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
ASSET=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
# Multicall3, canonical address, eth_getCode-confirmed on 4663. The read API batches its
# ~30 live views through aggregate3; one at a time they blow any sane deadline on a public RPC.
MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11

# Deadline on ONE batched live read, milliseconds. Default 8000. A batch is a single eth_call;
# past this the API answers from the index with live:false instead of hanging.
LIVE_READ_TIMEOUT_MS=

# ---- server ----
PORT=42069
