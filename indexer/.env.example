# ---------------------------------------------------------------------------
# Callhouse indexer — copy to .env.local (ponder loads that file automatically)
# ---------------------------------------------------------------------------

# ---- required ----

# Archive-capable RPC for chain 4663. The publicnode backup answers
# "Archive requests require a personal token" on historical eth_getLogs and
# therefore cannot backfill; use the primary for the indexer.
PONDER_RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com

# The deployed Callhouse vault. Alias: VAULT.
VAULT_ADDRESS=

# Block the vault was deployed in. Required: chain 4663 is past block
# 61,000,000 and a genesis scan is not a viable backfill.
START_BLOCK=

# Postgres. Omit for a local PGlite database under .ponder/pglite.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/callhouse

# Database schema (namespace). Ponder requires one explicitly; pass --schema
# on the CLI or set it here.
DATABASE_SCHEMA=callhouse

# ---- optional ----

# Scan the Overcall registry from earlier than the vault's deploy block so the
# cycles that ran before we launched still appear in the public tape.
# Defaults to START_BLOCK.
REGISTRY_START_BLOCK=

# Last block to index, inclusive. Leave unset in production (follow the head).
# Set it to bound a replay for a fork dry-run or a smoke test.
END_BLOCK=

# Shared secret for POST /v1/overcall/list. Unset ⇒ the relay answers 503.
# Generate with: openssl rand -hex 32
KEEPER_HMAC_SECRET=

# Overcall's listings API and the market to publish under.
OVERCALL_ORDERS_URL=https://overcall.finance/api/orders
OVERCALL_MARKET=NVDA

# ---- protocol addresses (defaults are the eth_getCode-confirmed mainnet ones) ----
# Override only for a fork or a dry-run deployment.
# REGISTRY is the NVDA registry. It is NOT the top-level `registry` key in
# Overcall's frontend config — that one (0x65dD4079...) is the JUGGERNAUT market.
REGISTRY=0x8E973cE1A6884E28Ad3E377d5f670Bc0b463f4EA
CLEARINGHOUSE=0x9a7b40e5c1dB1Af822ef091c990b58b02C78C0C0
SEAPORT=0x0000000000000068F116a894984e2DB1123eB395
USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
ASSET=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
OVERCALL_FEE_RECIPIENT=0xdAe7e82A2E7D566C67E87C164B05a1C560190782
# Multicall3, canonical address, eth_getCode-confirmed on 4663. The read API batches its
# ~35 live views through aggregate3; one at a time they blow any sane deadline on a public RPC.
MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11

# Deadline on ONE batched live read, milliseconds. Default 8000. A batch is a single eth_call;
# past this the API answers from the index with live:false instead of hanging.
LIVE_READ_TIMEOUT_MS=

# ---- server ----
PORT=42069
