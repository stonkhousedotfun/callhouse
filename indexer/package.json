{
  "name": "@callhouse/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ponder dev",
    "start": "ponder start",
    "serve": "ponder serve",
    "codegen": "ponder codegen",
    "gen:abis": "node scripts/gen-abis.mjs",
    "gen:card-registry": "node scripts/gen-card-registry.mjs",
    "check:card-registry": "node scripts/gen-card-registry.mjs --check",
    "gen:v2-registry": "node scripts/gen-v2-registry.mjs",
    "check:v2-registry": "node scripts/gen-v2-registry.mjs --check",
    "gen:reward-epochs": "node scripts/gen-reward-epochs.mjs",
    "check:reward-epochs": "node scripts/gen-reward-epochs.mjs --check",
    "build": "ponder codegen && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "scale:v2": "vitest run scripts/v2-scale.test.ts --reporter=verbose",
    "fork:sync": "node --experimental-strip-types scripts/fork-sync.ts",
    "v2:devnet-check": "node --experimental-strip-types scripts/v2-devnet-check.ts",
    "v2:dev-readonly-check": "node --experimental-strip-types scripts/v2-dev-readonly-check.ts",
    "maker:epoch": "node scripts/maker-epoch.mjs",
    "maker:post": "node scripts/post-maker-epoch.mjs"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "ponder": "^0.17.10",
    "viem": "^2.56.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.13",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@types/node": "^22.20.2",
    "drizzle-orm": "0.41.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
