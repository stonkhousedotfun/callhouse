{
  "name": "@callhouse/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "dryrun": "tsx src/dryrun.ts",
    "dryrun:extended": "tsx src/dryrun-extended.ts"
  },
  "dependencies": {
    "viem": "^2.56.3",
    "zod": "^3.25.76",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "@hono/node-server": "^2.1.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.23.13",
    "@types/node": "^22.20.2",
    "@types/better-sqlite3": "^9.6.0"
  }
}
