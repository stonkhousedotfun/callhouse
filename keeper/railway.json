{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "keeper/Dockerfile",
    "watchPatterns": [
      "keeper/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "web/package.json",
      "indexer/package.json",
      "ops/markets/tier1.json",
      "ops/markets/dev.json",
      "ops/markets/events.json",
      "ops/v2/monitor.mjs",
      "ops/abis/v2/roles.json",
      "ops/v2/go-live-gating.mjs",
      "ops/v8/prelaunch-gate.mjs",
      "ops/v8/tvl-threshold.mjs"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
