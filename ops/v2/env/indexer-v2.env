# ops/v2/env/indexer-v2.env — the v2 indexer (Ponder): events of the v2 contracts, API /v2/*.
# GENERATED by ops/v2-env.mjs from ops/markets/tier1.json (v2 interface version 8). Do not edit by hand:
# change the registry (or the renderer) and re-run; `node ops/v2-env.mjs --check` is the gate.
# Public values only. Every secret this service needs is a comment below, never a value.

# ---- v2 contracts (registry v2.contracts) ----
# registry v2.contracts.clearinghouse
V2_CLEARINGHOUSE=0x1A67948175DFf13426F0d61bfB483579D2ff2EeE
# registry v2.contracts.orderBook
V2_ORDER_BOOK=0x65A97a05e9726DA45794DA206943bbc4280b5ce6
# registry v2.contracts.settlementOracle
V2_SETTLEMENT_ORACLE=0x0e4F266b73e95dc6d4cA10674DCd5eF353e2BDCD
# registry v2.contracts.autoRoller
V2_AUTO_ROLLER=0x7C6Fbc78c460e7994e6A47f7AEe63E36709ab05D
# registry v2.contracts.makerRegistry
V2_MAKER_REGISTRY=0x6FeecE6CbE97b4f0b453eD6373a599795BdBBeee
# Optional sources the indexer also reads (calendar holidays, bounty payments); not in §7's list.
# registry v2.contracts.expiryCalendar
V2_EXPIRY_CALENDAR=0x5d0D98C6774B5db0b83D8Bc16FDd09a8Df826d18
# registry v2.contracts.keeperRewards
V2_KEEPER_REWARDS=0x475D2649E991f4D2f1E21dEB758cd1d6D76C27c5
# registry v2.contracts.makerVault
V2_MAKER_VAULT=0xfbC35FCc0508788b0a2eAF09bBb3Df04402d30A2
# registry v2.contracts.rewardsDistributor
V2_REWARDS_DISTRIBUTOR=0x08F233c5E338a35F7Ba6cD16C729AB61f40325ce
# v8: RouteSet / RouteCleared, so /v2/markets[].settlement.route follows the chain, not the registry.
# registry v2.contracts.payoutAdapter
V2_PAYOUT_ROUTER=0x6d97634501b52D78c8dEb77a7d9105587DBAAf18
# registry v2.deployBlock
V2_START_BLOCK=69512673

# ---- access control (v8: one AccessManager, V8-DESIGN §2) ----
# Roles, delays and the selector map are ops/abis/v2/roles.json, exported with the ABIs.
# registry v2.contracts.accessManager
V2_ACCESS_MANAGER=0xb663C1EAEeD4664515Cc864667263f3e75238da3
# /v2/config access block and /v2/admin/operations: role grants, delays and every scheduled,
# executed or cancelled operation come from this contract's events.

# ---- flywheel (v8: 50 % buyback and burn, 50 % Treasury Safe; V8-DESIGN §6) ----
# registry v2.flywheel.feeSplitter
V2_FEE_SPLITTER=0x52a5674FFD2aDe74738d2347ef1366Bdc1881C37
# registry v2.flywheel.buybackExecutor
V2_BUYBACK_EXECUTOR=0xE7Ae90cDCfF293C7434942bEF0aE7C7C59A39565
# registry shared.token.address
V2_FLYWHEEL_TOKEN_ADDRESS=0xc2525b7c68b6d66dE5AABFEDC7B13314F389D5C4
# The splitter is constructed BEFORE the core (it is the core's fee recipient), so its first
# event can precede V2_START_BLOCK: /v2/flywheel indexes from its own block.
# registry v2.flywheel.deployBlock
V2_FLYWHEEL_START_BLOCK=69512673

# ---- token (v8: the only thing ever burned; Stock Token fees are sold for USDG first) ----
# registry shared.token.address
V2_TOKEN=0xc2525b7c68b6d66dE5AABFEDC7B13314F389D5C4
# registry shared.token.decimals
V2_TOKEN_DECIMALS=18

# ---- Safes (v8: reported by /v2/config, watched by the monitor) ----
# registry shared.safes.admin
V2_ADMIN_SAFE=0x6f8A7B77b72511cD8939596b1659bA28C28f101B
# registry shared.safes.treasury
V2_TREASURY_SAFE=0x014b996a084690FB27265BfAC157b04e9FeBbF4E

# ---- Earn, Zap and House (v8 periphery; NOT in the registry) ----
# The registry has no slot for these (T-401 design B), so nothing here can render a value. Until they are
# set on Railway from the verified deploy output, this indexer does NOT index Earn, Zap or House.
# V2_EARN_VAULT=<not in the registry: the EarnVault (lending vault) address; unset = the indexer does not index EarnVault; set on Railway from the verified deploy output>
# V2_ZAP_HELPER=<not in the registry: the StockZap address; unset = the indexer does not index StockZap; set on Railway from the verified deploy output>
# V2_EARN_START_BLOCK=<not in the registry: EarnVault's deploy block; required with V2_EARN_VAULT or V2_ZAP_HELPER and refused without them; set on Railway from the verified deploy output>
# V2_HOUSE_VAULT_FACTORY=<not in the registry: the HouseVaultFactory address; unset = the indexer does not index House vaults; set on Railway from the verified deploy output>
# V2_HOUSE_START_BLOCK=<not in the registry: the factory's deploy block; required with V2_HOUSE_VAULT_FACTORY and refused without it; set on Railway from the verified deploy output>

# ---- services ----
# /v2/fair/:longId is proxied from the pricing service.
PRICING_URL=http://pricing.railway.internal:8790

# ---- database and chain ----
# DATABASE_URL=<secret: ${{Postgres.DATABASE_URL}} reference variable (shared Postgres); set on Railway, never in this file>
# DATABASE_SCHEMA stays UNSET: the image indexes into a schema named after RAILWAY_DEPLOYMENT_ID, one per
# deploy (ops/deploy.md §11.3; a fixed name crash-loops the second deploy). This is the stable name Ponder
# keeps views of the live deployment's tables under, beside v1's, for anyone querying Postgres directly.
DATABASE_VIEWS_SCHEMA=callhouse_v2
# PONDER_RPC_URL_4663=<secret: the archive RPC URL, which carries the provider's API key; set on Railway, never in this file>

# ---- process ----
# Railway probes $PORT: keep it equal to the service's own port.
PORT=42069
