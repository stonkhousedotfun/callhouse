# ops/v2/env/indexer-v2.env — the v2 indexer (Ponder): events of the v2 contracts, API /v2/*.
# GENERATED by ops/v2-env.mjs from ops/markets/tier1.json (v2 interface version 7). Do not edit by hand:
# change the registry (or the renderer) and re-run; `node ops/v2-env.mjs --check` is the gate.
# Public values only. Every secret this service needs is a comment below, never a value.

# ---- v2 contracts (registry v2.contracts) ----
# v2.contracts.clearinghouse is null in the registry: no production address configured. Populate only after owner publication and verification; re-run ops/v2-env.mjs.
V2_CLEARINGHOUSE=
# v2.contracts.orderBook is null in the registry: no production address configured. Populate only after owner publication and verification; re-run ops/v2-env.mjs.
V2_ORDER_BOOK=
# v2.contracts.settlementOracle is null in the registry: no production address configured. Populate only after owner publication and verification; re-run ops/v2-env.mjs.
V2_SETTLEMENT_ORACLE=
# v2.contracts.autoRoller is null in the registry: no production address configured. Populate only after owner publication and verification; re-run ops/v2-env.mjs.
V2_AUTO_ROLLER=
# v2.contracts.makerRegistry is null in the registry: no production address configured. Populate only after owner publication and verification; re-run ops/v2-env.mjs.
V2_MAKER_REGISTRY=
# Optional sources the indexer also reads (calendar holidays, bounty payments); not in §7's list.
# v2.contracts.expiryCalendar is null in the registry: no production address configured. Populate only after owner publication and verification; re-run ops/v2-env.mjs.
V2_EXPIRY_CALENDAR=
# v2.contracts.keeperRewards is null in the registry: no production address configured. Populate only after owner publication and verification; re-run ops/v2-env.mjs.
V2_KEEPER_REWARDS=
# v2.deployBlock is null in the registry: no production block configured. Populate only after owner publication and verification; re-run ops/v2-env.mjs.
V2_START_BLOCK=

# ---- services ----
# /v2/fair/:longId is proxied from the pricing service.
PRICING_URL=http://pricing.railway.internal:8790

# ---- database and chain ----
# DATABASE_URL=<secret: ${{Postgres.DATABASE_URL}} reference variable (shared Postgres); set on Railway, never in this file>
# DATABASE_SCHEMA stays UNSET: the image indexes into a schema named after RAILWAY_DEPLOYMENT_ID, one per
# deploy (ops/deploy.md §11.3; a fixed name crash-loops the second deploy). This is the stable name Ponder
# keeps views of the live deployment's tables under, beside v1's, for anyone querying Postgres directly.
DATABASE_VIEWS_SCHEMA=callhouse_v2
# PONDER_RPC_URL_4663=<secret: the archive RPC URL, which carries the provider's API key; set on Railway, never in this file>

# ---- process ----
# Railway probes $PORT: keep it equal to the service's own port.
PORT=42069
