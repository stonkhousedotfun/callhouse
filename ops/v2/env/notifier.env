# ops/v2/env/notifier.env — user notifications: subscriptions API and delivery (Telegram, Web Push, email).
# GENERATED by ops/v2-env.mjs from ops/markets/tier1.json (v2 interface version 7). Do not edit by hand:
# change the registry (or the renderer) and re-run; `node ops/v2-env.mjs --check` is the gate.
# Public values only. Every secret this service needs is a comment below, never a value.

# ---- services and chain ----
# The rules engine polls /v2/feed/activity here.
INDEXER_URL=http://indexer-v2.railway.internal:42069
# Used only to verify smart-wallet signatures (ERC-1271 / ERC-6492).
RH_RPC=https://rpc.mainnet.chain.robinhood.com
# The dapp origin: every message links into it and it is the only origin CORS admits.
APP_URL=https://app.stonkhouse.fun

# ---- storage ----
# DATABASE_URL=<secret: ${{Postgres.DATABASE_URL}} reference variable (shared Postgres, schema notifier); set on Railway, never in this file>
# NOTIFIER_DATA_KEY=<secret: 32 bytes hex, `openssl rand -hex 32`, encrypts stored targets; losing it orphans them; set on Railway, never in this file>

# ---- channels ----
# TELEGRAM_BOT_TOKEN=<secret: from @BotFather; the bot long-polls, so no webhook on it and ONE replica; set on Railway, never in this file>
# TELEGRAM_API_BASE is optional (default https://api.telegram.org); tests only.
# VAPID_PUBLIC_KEY=<set on Railway: generated together with VAPID_PRIVATE_KEY; public once generated>
# VAPID_PRIVATE_KEY=<secret: generated with the public key (web-push generate-vapid-keys); set on Railway, never in this file>
# VAPID_SUBJECT stays unset: it defaults to APP_URL, which is https (required only for an http APP_URL).
# SMTP_URL=<secret: optional; smtp(s)://user:pass@host; unset turns the email channel off; set on Railway, never in this file>
# With SMTP_URL only (the notifier refuses either without it): EMAIL_FROM=<sender address> and
# NOTIFIER_PUBLIC_URL=https://notify.stonkhouse.fun (the opt-in and unsubscribe links point there).

# ---- process ----
# Railway probes $PORT: keep it equal to the service's own port.
PORT=8791
