# status planned, wave wave2, mode vol (weekly chain, 2252 rows, spot divergence 11 bps).
# keeper 0x5af6b3c940123A7D95B615562cFE66D5B62eB625 (ops mnemonic index 29); KEEPER_PK is NOT here: it is layered on
# at deploy time from ~/.callhouse-keys/markets/NBIS.env (ops/keeper-railway.sh). VAULT is never set:
# the pooled vault is closed and its keeper runs WIND_DOWN as its own service.

# ---- the market ----
KEEPER_MARKET=NBIS
# Planned: no factory yet. contracts/script/DeploySoloBatch.sh writes deployment.factory into the
# registry; re-run ops/keeper-env.sh afterwards. A keeper booted on this file exits 1 with
# "VAULT / FACTORY: at least one must be set", which is the correct answer until then.
FACTORY=
# Nebius Group • Robinhood Token (18 dp); cross-checked against factory.asset() at boot.
ASSET=0x9D9c6684F596F66a64C030B93A886D51Fd4D7931
# Chainlink proxy "Robinhood NBIS / USD" (8 dp); cross-checked against factory.priceFeed() at boot.
PRICE_FEED=0xE1D87B116Ba0fe898998f1D140339D1fA1E09705

# ---- shared protocol (registry.shared) ----
# Our own Clear, not Overcall's: the factory was constructed against it (factory.clear() is cross-checked).
CLEARINGHOUSE=0x53d7A6d0489Daf3d67b9A314e0eAB2B78Acab9C6
USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
SEAPORT=0x0000000000000068F116a894984e2DB1123eB395

# ---- pricing (keeper/README.md → Environment) ----
KEEPER_PRICING_MODE=vol
# Cboe's delayed chain for NBIS: 2252 rows, weekly expiries, spot divergence 11 bps at the registry build.
KEEPER_VOL_URL=https://cdn.cboe.com/api/global/delayed_quotes/options/NBIS.json
KEEPER_VOL_ROOT=NBIS
# fixed mode: strike = spot + this, rounded down to a whole USDG, inside the factory band.
KEEPER_STRIKE_OTM_BPS=500
# The ask is never below this many USDG base units (registry minAskUsdg6); the config default is 1 USDG.
KEEPER_MIN_ASK_USDG6=100000
KEEPER_TARGET_DELTA=0.15
KEEPER_PRICE_EDGE_BPS=1000
KEEPER_PREMIUM_MARGIN_BPS=100

# ---- process ----
# One SQLite file per market on the service's /data volume; never share a volume between two keepers.
KEEPER_DB_PATH=/data/keeper-nbis.db
KEEPER_PORT=8787
PORT=8787
RH_RPC=https://rpc.mainnet.chain.robinhood.com
RH_RPC_2=https://robinhood-rpc.publicnode.com
POLL_INTERVAL_MS=60000
# The relay over Railway's private network; ALERT_WEBHOOK_TOKEN is ${{relay.RELAY_TOKEN}} on the service.
ALERT_WEBHOOK=http://relay.railway.internal:8080/alert
