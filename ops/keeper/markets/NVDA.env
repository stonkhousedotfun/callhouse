# ---- the market ----
KEEPER_MARKET=NVDA
# AccountFactory, deployed block 64038234 (0x8ef58643dc5d47e737ad62fcfc5499c591bb04ee3d98f897525c14ed5784f2e5), implementation 0xe412…45EC.
