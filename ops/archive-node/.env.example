# ops/archive-node/.env.example — copy to .env on the host. .env holds keyed URLs: never commit it.

# Ethereum mainnet (the parent chain of 4663). Both required. Keyed provider URLs are fine here.
PARENT_CHAIN_RPC_URL=
PARENT_CHAIN_BEACON_URL=

# First start only (ignored once /data holds a database). Trailing slash required. Choose it ON THE DAY per
# these rules: the newest Archive-path snapshot built by a stable Nitro no newer than the image, and within the
# ~18-day L1 blob window unless you also set a blob-archive secondary beacon URL. Example (2026-09-06, v3.11.4):
#   https://robinhood-snapshots.offchainlabs.com/robinhood%20chain/2026-09-06-a346dc6c/
SNAPSHOT_URL=

# Host side (docker-compose.yml only).
ARCHIVE_DATA_DIR=/mnt/nvme/archive-4663
ARCHIVE_BIND_ADDR=127.0.0.1

# Optional extra Nitro flags, space separated.
EXTRA_NITRO_ARGS=
